{% extends "base.html.j2" %}
{% from "_macros.j2" import chip, delta %}
{% block title %}Draft & Keepers · The League{% endblock %}
{% block content %}
<h1 class="page-title">Draft &amp; Keepers</h1>

<section class="section">
  <h2>Keeper rules</h2>
  <ol class="rules">
    {% for r in keepers.rules %}<li>{{ r }}</li>{% endfor %}
  </ol>
</section>

<section class="section">
  <h2>The audit</h2>
  <p class="note"><strong class="num">{{ summary.charged_ok }} of {{ summary.n }}</strong> historical keepers charged correctly, the way the rule reads.{% if summary.charged_ok == summary.n and not flagged %} Six seasons, zero disputes. The books are clean.{% endif %}</p>
  {% if flagged %}
  <div class="board-panel">
    <table class="sortable">
      <thead><tr><th class="num">Season</th><th>Manager</th><th>Player</th><th class="num">Drafted rd</th><th class="num">Kept at</th><th class="num">Rule says</th><th>Flags</th></tr></thead>
      <tbody>
      {% for a in flagged %}
        <tr>
          <td class="num">{{ a.season }}</td>
          <td data-sort="{{ users[a.user_id].name if a.user_id in users else a.name }}">{{ chip(users[a.user_id].name if a.user_id in users else a.name, users[a.user_id].avatar if a.user_id in users else '', 'managers/' ~ users[a.user_id].slug ~ '.html' if a.user_id in users else None) }}</td>
          <td>{{ a.player_name }}</td>
          <td class="num">{{ a.prev_round }}</td>
          <td class="num neg">{{ a.keep_round }}</td>
          <td class="num pos">{{ a.need }}</td>
          <td>{% if not a.charged_ok %}<span class="neg">wrong round</span>{% endif %}{% if not a.eligible_round %} <span class="neg">round-ineligible</span>{% endif %}{% if a.repeat_keep %} <span class="neg">repeat keep</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

{% if collisions %}
<section class="section">
  <h2>Round collisions</h2>
  <p class="note">Trade for a keeper who went in the same round as one of your own and only one of them can hold that slot. The other moves up a round. These are legal, not misses.</p>
  <div class="board-panel">
    <table>
      <thead><tr><th class="num">Season</th><th>Manager</th><th>Player</th><th class="num">Drafted rd</th><th class="num">Charged</th></tr></thead>
      <tbody>
      {% for a in collisions %}
        <tr>
          <td class="num">{{ a.season }}</td>
          <td>{{ chip(users[a.user_id].name if a.user_id in users else a.name, users[a.user_id].avatar if a.user_id in users else '', 'managers/' ~ users[a.user_id].slug ~ '.html' if a.user_id in users else None) }}</td>
          <td>{{ a.player_name }}</td>
          <td class="num">{{ a.prev_round }}</td>
          <td class="num hot">{{ a.keep_round }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

{% if keepers.declared_next %}
<section class="section">
  <h2>Declared {{ meta.current_season }} keepers</h2>
  <div class="board-panel">
    <table>
      <thead><tr><th>Manager</th><th>Keeping</th><th class="num">Round</th></tr></thead>
      <tbody>
      {% for k in keepers.declared_next %}
        <tr>
          <td>{{ chip(users[k.user_id].name if k.user_id in users else k.name, users[k.user_id].avatar if k.user_id in users else '') }}</td>
          <td>{{ k.player_name }}</td><td class="num hot">{{ k.round }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

<section class="section">
  <h2>Keeper value</h2>
  <p class="note">Surplus = the keeper's points that season minus the average of everyone drafted in the same round. Positive means the keep beat the market.</p>
  <div class="two-up">
    <div class="board-panel">
      <table>
        <thead><tr><th>Manager</th><th class="num">Keeps</th><th class="num">Avg surplus</th><th class="num">Hit rate</th></tr></thead>
        <tbody>
        {% for r in keepers.by_manager %}
          <tr><td>{{ chip(users[r.user_id].name if r.user_id in users else r.name, users[r.user_id].avatar if r.user_id in users else '') }}</td>
          <td class="num">{{ r.keeps }}</td>
          <td class="num" data-sort="{{ r.avg_surplus }}">{{ delta(r.avg_surplus) }}</td>
          <td class="num">{{ r.hit_rate|pct }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div>
      {% for k in keepers.value[:5] %}
      <div class="marquee"><span class="line-name">{{ k.season }} · kept round {{ k.keep_round }} by {{ users[k.user_id].name if k.user_id in users else k.name }}</span>
        <span class="posted-sm">{{ k.player_name }}</span>
        <span class="detail">{{ k.points|fmt0 }} pts · {{ delta(k.surplus) }} vs the round</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <h2>Steals &amp; busts</h2>
  <div class="two-up">
    <div class="board-panel">
      <table>
        <thead><tr><th colspan="2">Biggest steals</th><th class="num">Rd</th><th class="num">Pts</th><th class="num">Surplus</th></tr></thead>
        <tbody>
        {% for s in d.steals %}
          <tr><td class="num">{{ s.season }}</td><td>{{ s.player_name }} <span class="fine">({{ users[s.manager_user].name if s.manager_user in users else s.name }})</span></td>
          <td class="num">{{ s.round }}</td><td class="num">{{ s.points|fmt0 }}</td>
          <td class="num pos">+{{ s.surplus|fmt0 }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="board-panel">
      <table>
        <thead><tr><th colspan="2">Biggest busts</th><th class="num">Rd</th><th class="num">Pts</th><th class="num">Surplus</th></tr></thead>
        <tbody>
        {% for s in d.busts %}
          <tr><td class="num">{{ s.season }}</td><td>{{ s.player_name }} <span class="fine">({{ users[s.manager_user].name if s.manager_user in users else s.name }})</span></td>
          <td class="num">{{ s.round }}</td><td class="num">{{ s.points|fmt0 }}</td>
          <td class="num neg">{{ s.surplus|fmt0 }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section">
  <h2>What a round is worth</h2>
  <div class="board-panel pad">{{ by_round_chart|safe }}</div>
  <div class="board-panel">
    <table class="sortable">
      <thead><tr><th class="num">Rd</th><th class="num">Avg pts</th><th class="num">Hit rate</th></tr></thead>
      <tbody>
      {% for r in d.by_round %}
        <tr><td class="num">{{ r.round }}</td>
        <td class="num">{{ r.avg_points|fmt0 }}</td>
        <td class="num">{{ r.hit_rate|pct }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="note">Average regular-season points per pick, by round, all seasons.
  Hit rate = the share of that round's picks that at least met the round's own
  average. That is how often a pick pays its price.</p>
</section>

<section class="section">
  <h2>Draft slot outcomes</h2>
  <div class="board-panel">
    <table class="sortable">
      <thead><tr><th class="num">Slot</th><th class="num">Drafts</th><th class="num">Avg finish</th><th class="num">Titles</th><th class="num">Playoff rate</th><th>Era note</th></tr></thead>
      <tbody>
      {% for r in d.slot_outcomes %}
        <tr><td class="num">{{ r.slot }}</td><td class="num">{{ r.n }}</td>
        <td class="num">{{ r.avg_finish }}</td><td class="num{% if r.titles %} hot{% endif %}">{{ r.titles }}</td>
        <td class="num">{{ r.playoff_rate|pct }}</td><td class="fine">{{ r.era_note }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="section">
  <h2>Early-round DNA</h2>
  <p class="note">Where each manager spends rounds 1–10, as a share of their
  non-keeper picks, all seasons pooled. Amber marks the position they can't
  quit.</p>
  <div class="board-panel">
    <table class="sortable">
      <thead><tr><th>Manager</th><th class="num">QB</th><th class="num">RB</th><th class="num">WR</th><th class="num">TE</th></tr></thead>
      <tbody>
      {% for r in tendency_rows %}
        <tr>
          <td data-sort="{{ users[r.user_id].name }}">{{ chip(users[r.user_id].name, users[r.user_id].avatar, 'managers/' ~ users[r.user_id].slug ~ '.html') }}</td>
          {% for p in ('QB', 'RB', 'WR', 'TE') %}
          <td class="num{% if r[p] == r.top %} hot{% endif %}">{{ r[p]|pct }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<section class="section">
  <h2>The superflex question</h2>
  <p class="note">Does drafting QBs early actually win here? First QB round vs
  final finish, grouped by season, earliest reach first. Amber marks a
  first-place finish.</p>
  <div class="board-panel">
    <table>
      <thead><tr><th>Manager</th><th class="num">First QB rd</th><th class="num">QBs in first 5</th><th class="num">Finish</th></tr></thead>
      <tbody>
      {% for g in qb_groups %}
        <tr class="group-row"><th scope="rowgroup">{{ g.season }}</th>
          <td colspan="3">{{ g.teams }} teams · earliest QB first</td></tr>
        {% for r in g.rows %}
        <tr>
          <td>{{ chip(users[r.user_id].name if r.user_id in users else '?', users[r.user_id].avatar if r.user_id in users else '', 'managers/' ~ users[r.user_id].slug ~ '.html' if r.user_id in users else None) }}</td>
          <td class="num">{{ r.first_qb_round if r.first_qb_round is not none else '–' }}</td>
          <td class="num">{{ r.qbs_in_first_5 }}</td>
          <td class="num{% if r.finish == 1 %} hot{% endif %}">{{ r.finish if r.finish is not none else '–' }}</td>
        </tr>
        {% endfor %}
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
