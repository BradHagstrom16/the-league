{% extends "base.html.j2" %}
{% from "_macros.j2" import chip %}
{% block title %}The League — the board{% endblock %}
{% block content %}

{% if status in ("pre_draft", "drafting") %}
<section class="section draft-room post-in">
  <div class="hero-board">
    <img class="hero-crest" src="assets/img/logo.png" alt="The League — Trojan raising a beer over the wordmark" width="300" height="300">
    <div class="hero-copy">
      <h1>The Draft Room is open</h1>
      <p class="note">Season {{ meta.current_season }} hasn't kicked off. Keepers are being declared, picks are being plotted, and somebody is about to reach.</p>
      {% if declared %}
      <div class="board-panel">
        <table>
          <thead><tr><th>Manager</th><th>Keeping</th><th class="num">Round</th></tr></thead>
          <tbody>
          {% for k in declared %}
            <tr>
              <td>{{ chip(users[k.user_id].name if k.user_id in users else k.name, users[k.user_id].avatar if k.user_id in users else '', root ~ 'managers/' ~ users[k.user_id].slug ~ '.html' if k.user_id in users else None) }}</td>
              <td>{{ k.player_name }}</td>
              <td class="num hot">{{ k.round }}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="note">{{ declared|length }} keeper{{ 's' if declared|length != 1 }} declared so far · <a href="draft.html">rules and full draft history</a></p>
      {% else %}
      <p class="note">No keepers declared yet. <a href="draft.html">Keeper rules and draft history →</a></p>
      {% endif %}
    </div>
  </div>
</section>
{% elif status == "complete" %}
<section class="section post-in">
  <div class="marquee">
    <span class="line-name">Reigning champion</span>
    <span class="posted">{{ reigning.champion_name }}</span>
    <span class="detail">{{ reigning.season }} season{% if lore.trophy_name %} · holder of {{ lore.trophy_name }}{% endif %}</span>
  </div>
</section>
{% else %}
<section class="section post-in">
  <div class="marquee">
    <span class="line-name">Season {{ meta.current_season }} — live</span>
    <span class="detail">Fresh lines post every Tuesday morning. <a href="seasons/{{ meta.current_season }}.html">This week's board →</a></span>
  </div>
</section>
{% endif %}

<section class="section">
  <h2>The house</h2>
  <div class="two-up">
    <div class="marquee">
      <span class="line-name">Reigning champion — {{ reigning.season }}</span>
      <span class="posted">{{ chip(reigning.champion_name, users[reigning.champion_user].avatar if reigning.champion_user in users else '', root ~ 'managers/' ~ users[reigning.champion_user].slug ~ '.html' if reigning.champion_user in users else None) }}</span>
      <span class="detail">{% if lore.trophy_name %}Holder of {{ lore.trophy_name }}.{% else %}Trophy name unrecorded; commissioner, fill in <code>league_lore.yml</code>.{% endif %}</span>
    </div>
    <div class="marquee shame">
      <span class="line-name">Current punishment holder — {{ reigning.season }} last place</span>
      <span class="posted">{{ chip(last_place.name, users[last_place.user_id].avatar if last_place.user_id in users else '', root ~ 'managers/' ~ users[last_place.user_id].slug ~ '.html' if last_place.user_id in users else None) }}</span>
      <span class="detail">{% if lore.punishments.get(reigning.season|string) or lore.punishments.get(reigning.season) %}{{ lore.punishments.get(reigning.season|string) or lore.punishments.get(reigning.season) }}{% else %}Punishment unrecorded. The group chat knows.{% endif %}</span>
    </div>
  </div>
</section>

<section class="section">
  <h2>House records</h2>
  {% for r in marquee %}
  <div class="marquee posted-line">
    <span class="line-name">{{ r.label }}</span>
    <span class="posted">{{ r.value|line }}</span>
    <span class="detail">{{ r.holder }} · {{ r.detail }}</span>
  </div>
  {% endfor %}
  <p class="note"><a href="records.html">The full record book →</a></p>
</section>

<section class="section">
  <h2>All-time lines</h2>
  <p class="note">Regular season, {{ meta.seasons[0] }}–{{ meta.seasons[-1] }}. Click a column to sort; a hot win percentage on one season is still one season.</p>
  <div class="board-panel">
    <table class="sortable">
      <thead><tr>
        <th>Manager</th><th class="num">Seasons</th><th class="num">W</th><th class="num">L</th>
        <th class="num">Win %</th><th class="num">PF</th><th class="num">Titles</th>
        <th class="num">Playoffs</th><th class="num">Last places</th>
      </tr></thead>
      <tbody>
      {% set top3_pct = (career.managers | map(attribute='win_pct') | sort(reverse=true) | list)[:3] %}
      {% for m in career.managers %}
        <tr>
          <td data-sort="{{ m.name }}">{{ chip(m.name, m.avatar, root ~ 'managers/' ~ users[m.user_id].slug ~ '.html', users[m.user_id].rot) }}{% if not m.active %} <span class="fine">(departed)</span>{% endif %}</td>
          <td class="num">{{ m.seasons }}</td>
          <td class="num">{{ m.wins }}</td>
          <td class="num">{{ m.losses }}</td>
          <td class="num{% if m.win_pct in top3_pct %} hot{% endif %}">{{ m.win_pct|pct }}</td>
          <td class="num">{{ m.pf|fmt0 }}</td>
          <td class="num{% if m.titles %} hot{% endif %}">{{ m.titles }}</td>
          <td class="num">{{ m.playoff_apps }}</td>
          <td class="num">{{ m.last_places }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
